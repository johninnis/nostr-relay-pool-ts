{
  "name": "@innis/nostr-relay-pool",
  "version": "0.2.0",
  "links": ["../nostr-core-ts", "../coding-standards-ts"],
  "license": "MIT",
  "description": "TypeScript Nostr relay pool: WebSocket subscriptions, publishes, NIP-42 AUTH, exponential backoff, and latency tracking.",
  "exports": {
    ".": "./mod.ts",
    "./testing": "./testing.ts"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/path": "jsr:@std/path@^1",
    "@innis/nostr-core": "jsr:@innis/nostr-core@^0.4.0",
    "@innis/nostr-core/testing": "jsr:@innis/nostr-core@^0.4.0/testing"
  },
  "tasks": {
    "check": "deno check mod.ts testing.ts src/ tests/ examples/",
    // The in-memory relay narrows wire filters it has checked are records to NostrFilter, which compileFilters reads defensively
    "lint": "deno lint --ignore=cov_profile/,testing.ts && deno lint --rules-exclude=innis/no-type-assertions testing.ts",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "test": "deno test -A",
    "coverage": "rm -rf cov_profile && deno test -A --coverage=cov_profile && deno coverage cov_profile --lcov --output=cov_profile/lcov.info && deno coverage cov_profile && deno run --allow-read jsr:@innis/coding-standards@^0.2.3/check-coverage",
    "exports-tested": "deno run --allow-read --allow-run jsr:@innis/coding-standards@^0.2.3/check-exports-tested",
    "docs": "deno run --allow-read --allow-run jsr:@innis/coding-standards@^0.2.3/check-docs",
    "lint-exemptions": "deno run --allow-read --allow-run jsr:@innis/coding-standards@^0.2.3/check-lint-exemptions",
    "publish:dry": "deno publish --dry-run",
    "ci": "deno task fmt:check && deno task lint && deno task lint-exemptions && deno task check && deno task coverage && deno task exports-tested && deno task docs"
  },
  "lint": {
    "plugins": ["jsr:@innis/coding-standards@^0.2.3/lint-plugin"],
    "rules": {
      "include": ["no-console", "ban-untagged-todo", "explicit-function-return-type", "no-non-null-assertion"],
      "exclude": ["require-await"]
    }
  },
  "fmt": {
    "semiColons": false,
    "lineWidth": 120,
    "exclude": ["**/*.md"]
  },
  "publish": {
    "exclude": ["tests/", "deno.lock", ".github/"]
  },
  "minimumDependencyAge": {
    "age": "PT24H",
    "exclude": ["jsr:@innis/*"]
  }
}
